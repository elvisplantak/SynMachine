diff --git a/docs/RECOVERY_REFERENCE_CHECKS.md b/docs/RECOVERY_REFERENCE_CHECKS.md
index b45f312..b34e12c 100644
--- a/docs/RECOVERY_REFERENCE_CHECKS.md
+++ b/docs/RECOVERY_REFERENCE_CHECKS.md
@@ -45,0 +46,4 @@ trust, mechanical closure, fluidic sealing or unchanged physical state between r
+Both bracketing STATUS request IDs are consumed by the round. Equal IDs within
+one observation or reuse of either ID from any earlier observation permanently
+invalidates the round and clears its confirmations, including when a queued
+duplicate reply passes the Serial client's normal correlation checks.
diff --git a/tests/test_fresh_hardware_observations.py b/tests/test_fresh_hardware_observations.py
index a2689f0..b6a4986 100644
--- a/tests/test_fresh_hardware_observations.py
+++ b/tests/test_fresh_hardware_observations.py
@@ -74,0 +75,19 @@ def test_existing_protocol_and_sf_reads_do_not_authorize_release(devices):
+def test_observation_preserves_both_status_request_ids(devices):
+    report = observe(devices)
+    requests = [json.loads(value)["request_id"] for value in devices[2].writes[1:]]
+    assert report.arduino_status_request_ids == tuple(requests)
+    assert len(set(requests)) == 2
+    assert report.arduino_status.request_id == requests[1]
+
+
+def test_same_request_id_inside_observation_is_rejected(devices):
+    client, _, port, session = devices
+    request_id = uuid.uuid4()
+    client._request_id_factory = lambda: request_id
+    with pytest.raises(ArduinoProtocolError, match="distinct status request IDs"):
+        observe(devices)
+    assert port.query_count == 2
+    assert session.closed and session.writes == []
+    assert all(json.loads(value)["type"] in {"HELLO", "QUERY_STATUS"} for value in port.writes)
+
+
